# Copy to .env and adjust. Everything is optional.
RUGGUARD_NETWORK=mainnet
# RUGGUARD_RPC_URL=https://rpc.mainnet.near.org
# RUGGUARD_FASTNEAR_URL=https://api.fastnear.com
# RUGGUARD_NEARBLOCKS_URL=https://api.nearblocks.io
# NEARBLOCKS_API_KEY=
# Seconds between NearBlocks calls (default 10 without a key, 1 with one)
# RUGGUARD_NEARBLOCKS_MIN_INTERVAL_S=10
RUGGUARD_DB=data/rugguard.db
RUGGUARD_TIMEOUT_S=20
RUGGUARD_MAX_RETRIES=3
RUGGUARD_CACHE_TTL_S=21600
# 1 = never touch the network; replay cached responses only
RUGGUARD_OFFLINE=0
RUGGUARD_VAULT=vault.rugguard-jd.testnet
RUGGUARD_ORACLE=oracle.rugguard-jd.testnet
RUGGUARD_AGENT=agent.rugguard-jd.testnet